# Copy to .env and fill in. Never commit .env. Sandbox / test credentials only.
# Every value below is a placeholder.

# ---- Server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Fields with model confidence below this are highlighted for the reviewer (0..1)
CONFIDENCE_THRESHOLD=0.8
MAX_UPLOAD_BYTES=20971520

# ---- Database: native PostgreSQL on Windows for dev, Azure Database for PostgreSQL in prod ----
DATABASE_URL=postgresql://invoice_bridge:change-me@localhost:5432/invoice_bridge
# Used only by `npm test`. Must be a separate database whose name contains "test" (tests truncate it).
# The role needs CREATEDB, or create the database yourself first.
TEST_DATABASE_URL=postgresql://invoice_bridge:change-me@localhost:5432/invoice_bridge_test

# ---- File storage ----
# local = files on disk (dev); azure = Azure Blob Storage (prod)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=invoices

# ---- Azure AI Document Intelligence (prebuilt-invoice model) ----
AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=<your-document-intelligence-key>

# ---- Extraction worker ----
# true = run the worker (and the accounting sweeper) inside the web process
RUN_WORKER_IN_PROCESS=false
WORKER_MAX_ATTEMPTS=5
WORKER_BATCH_SIZE=4
WORKER_POLL_INTERVAL_MS=2000
# A claim older than this is presumed to belong to a crashed worker and is re-queued
WORKER_LEASE_SECONDS=300
WORKER_BACKOFF_BASE_MS=5000
WORKER_BACKOFF_MAX_MS=600000

# ---- Xero (developer app connected to the Demo Company only) ----
XERO_CLIENT_ID=<your-xero-client-id>
XERO_CLIENT_SECRET=<your-xero-client-secret>
XERO_REDIRECT_URI=http://localhost:3000/auth/xero/callback
# Granular scopes (Xero apps created from March 2026). Older apps: replace accounting.invoices
# with accounting.transactions.
XERO_SCOPES=openid profile email offline_access accounting.invoices accounting.contacts accounting.settings.read
# Optional: pin an organisation. Default = first one granted (connect only the Demo Company).
XERO_TENANT_ID=
# Expense account for bill lines in the Demo Company chart of accounts
XERO_DEFAULT_ACCOUNT_CODE=400
# Optional TaxType for bill lines (AU demo: INPUT; UK demo: INPUT2). Empty = account default.
XERO_TAX_TYPE=
ACCOUNTING_MAX_POST_ATTEMPTS=5
ACCOUNTING_SWEEP_INTERVAL_MS=30000

# 32 random bytes, base64. Encrypts stored OAuth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=<base64-32-bytes>
